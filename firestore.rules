rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Only authenticated users may read/write their own test-type subcollections.
    match /users/{userId}/{category}/{docId} {
      allow read, write: if request.auth != null
                       && request.auth.uid == userId
                       && category in [
                         'drawing',
                         'questionnaire',
                         'tremor',
                         'tapping',
                         'voice',
                         'camera',
                         'neuropsychological'
                       ];
    }

    // Allow users to read their own profile document and update it when authenticated.
    match /users/{userId} {
      // Only allow reading or updating your own profile document
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Allow patients and doctors to manage reports.
    match /reports/{reportId} {
      allow create: if request.auth != null
                    && request.resource.data.patientId == request.auth.uid;
      allow read, update: if request.auth != null
                          && (request.auth.uid == resource.data.patientId
                              || request.auth.uid == resource.data.doctorId);
      allow delete: if false;
    }

    // Deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
