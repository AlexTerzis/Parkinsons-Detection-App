rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Only authenticated users may read/write their own test‐type subcollections.
    match /users/{userId}/{category}/{docId} {
      allow read, write: if request.auth != null
                       && request.auth.uid == userId
                       && category in [
                         'drawing',
                         'questionnaire',
                         'tremor',
                         'tapping',
                         'voice',
                         'camera'
                       ];
    }

    // Lock everything else down
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
