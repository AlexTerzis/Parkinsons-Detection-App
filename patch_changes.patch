diff --git a/lib/ui/views/neuro_test/steps/delayed_recall.dart b/lib/ui/views/neuro_test/steps/delayed_recall.dart
new file mode 100644
index 0000000000000000000000000000000000000000..dd4d2080cd79f9824f7d4b997909d287c8ca85bc
--- /dev/null
+++ b/lib/ui/views/neuro_test/steps/delayed_recall.dart
@@ -0,0 +1,297 @@
+import 'dart:math';
+import 'package:flutter/material.dart';
+import 'package:speech_to_text/speech_to_text.dart';
+
+/// Executes the delayed recall portion of the MoCA verbal memory test.
+/// The patient first attempts free recall. Words not remembered are then
+/// probed with a category cue followed by a 3-option multiple choice.
+class DelayedRecallStep extends StatefulWidget {
+  final void Function(int score, VerbalMemoryResult result) onFinished;
+  final List<String> immediateTrials;
+
+  const DelayedRecallStep({
+    Key? key,
+    required this.onFinished,
+    required this.immediateTrials,
+  }) : super(key: key);
+
+  @override
+  State<DelayedRecallStep> createState() => _DelayedRecallStepState();
+}
+
+class _DelayedRecallStateData {
+  String freeRecall = '';
+  final Map<String, String?> category = {};
+  final Map<String, String?> choice = {};
+}
+
+class _DelayedRecallStepState extends State<DelayedRecallStep> {
+  static const _words = [
+    'ΠΡΟΣΩΠΟ',
+    'ΒΕΛΟΥΔΟ',
+    'ΕΚΚΛΗΣΙΑ',
+    'ΜΑΡΓΑΡΙΤΑ',
+    'ΚΟΚΚΙΝΟ',
+  ];
+  static const _cues = {
+    'ΠΡΟΣΩΠΟ': 'ένα μέρος του σώματος',
+    'ΒΕΛΟΥΔΟ': 'ένα είδος υφάσματος',
+    'ΕΚΚΛΗΣΙΑ': 'ένας τόπος λατρείας',
+    'ΜΑΡΓΑΡΙΤΑ': 'ένα είδος λουλουδιού',
+    'ΚΟΚΚΙΝΟ': 'ένα χρώμα',
+  };
+  static const _choices = {
+    'ΠΡΟΣΩΠΟ': ['ΠΡΟΣΩΠΟ', 'ΓΕΦΥΡΑ', 'ΛΑΜΠΑ'],
+    'ΒΕΛΟΥΔΟ': ['ΒΕΛΟΥΔΟ', 'ΜΕΤΑΞΙ', 'ΜΑΧΑΙΡΙ'],
+    'ΕΚΚΛΗΣΙΑ': ['ΕΚΚΛΗΣΙΑ', 'ΕΡΓΟΣΤΑΣΙΟ', 'ΚΑΦΕΝΕΙΟ'],
+    'ΜΑΡΓΑΡΙΤΑ': ['ΜΑΡΓΑΡΙΤΑ', 'ΤΟΥΛΙΠΑ', 'ΔΡΥΣ'],
+    'ΚΟΚΚΙΝΟ': ['ΚΟΚΚΙΝΟ', 'ΠΡΑΣΙΝΟ', 'ΓΑΛΑΖΙΟ'],
+  };
+
+  final SpeechToText _speech = SpeechToText();
+  final TextEditingController _controller = TextEditingController();
+  bool _speechAvailable = false;
+  bool _listening = false;
+  int _stage = 0; // 0 free recall, 1 cue/choice per word
+  int _wordIndex = 0;
+  List<String> _missing = [];
+  final _DelayedRecallStateData _data = _DelayedRecallStateData();
+  bool _finished = false;
+
+  @override
+  void initState() {
+    super.initState();
+    _initSpeech();
+  }
+
+  Future<void> _initSpeech() async {
+    _speechAvailable = await _speech.initialize();
+    setState(() {});
+  }
+
+  void _toggleListening() async {
+    if (!_speechAvailable) return;
+    if (_listening) {
+      await _speech.stop();
+      setState(() => _listening = false);
+    } else {
+      setState(() {
+        _listening = true;
+        _controller.text = '';
+      });
+      await _speech.listen(
+        localeId: 'el_GR',
+        onResult: (r) {
+          setState(() => _controller.text = r.recognizedWords);
+        },
+        listenMode: ListenMode.dictation,
+        partialResults: true,
+      );
+    }
+  }
+
+  void _finishFreeRecall() {
+    _data.freeRecall = _controller.text.trim();
+    _controller.clear();
+    final recalled =
+        _data.freeRecall.toUpperCase().split(RegExp(r'[\s,]+')).toSet();
+    _missing = _words.where((w) => !recalled.contains(w)).toList();
+    _stage = _missing.isEmpty ? 3 : 1;
+    _wordIndex = 0;
+    setState(() {});
+  }
+
+  bool _wordInText(String word, String text) {
+    final normalized = text.toUpperCase().split(RegExp(r'[\s,]+'));
+    return normalized.contains(word);
+  }
+
+  void _submitCue() {
+    final w = _missing[_wordIndex];
+    final answer = _controller.text.trim();
+    _data.category[w] = answer.isEmpty ? null : answer;
+    if (_wordInText(w, answer)) {
+      _advanceWord();
+    } else {
+      setState(() => _stage = 2); // move to multiple choice
+    }
+  }
+
+  void _submitChoice(String choice) {
+    final w = _missing[_wordIndex];
+    _data.choice[w] = choice;
+    _advanceWord();
+  }
+
+  void _advanceWord() {
+    _controller.clear();
+    _wordIndex++;
+    if (_wordIndex >= _missing.length) {
+      _complete();
+    } else {
+      setState(() => _stage = 1); // next cue if needed
+    }
+  }
+
+  void _complete() {
+    if (_finished) return;
+    _finished = true;
+    final recalled = _data.freeRecall.toUpperCase().split(RegExp(r'[\s,]+'));
+    final score = _words.where(recalled.contains).length;
+    widget.onFinished(
+      score,
+      VerbalMemoryResult(
+        immediateTrials: widget.immediateTrials,
+        delayedFreeRecall: _data.freeRecall,
+        categoryCueAnswers: _data.category,
+        choiceAnswers: _data.choice,
+        score: score,
+      ),
+    );
+  }
+
+  @override
+  void dispose() {
+    _speech.stop();
+    _controller.dispose();
+    super.dispose();
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    if (_stage == 0) {
+      return Scaffold(
+        appBar: AppBar(title: const Text('Καθυστερημένη Ανάκληση')),
+        body: Padding(
+          padding: const EdgeInsets.all(16),
+          child: Column(
+            crossAxisAlignment: CrossAxisAlignment.stretch,
+            children: [
+              const Text(
+                'Πείτε ξανά όσες από τις πέντε λέξεις θυμάστε.',
+                textAlign: TextAlign.center,
+              ),
+              const SizedBox(height: 12),
+              TextField(
+                controller: _controller,
+                decoration: const InputDecoration(
+                  border: OutlineInputBorder(),
+                  hintText: 'Απαντήσεις',
+                ),
+              ),
+              const SizedBox(height: 12),
+              Row(
+                mainAxisAlignment: MainAxisAlignment.center,
+                children: [
+                  IconButton(
+                    onPressed: _toggleListening,
+                    icon: Icon(_listening ? Icons.stop : Icons.mic),
+                  ),
+                  const SizedBox(width: 24),
+                  ElevatedButton(
+                    onPressed: _controller.text.isEmpty && !_listening ? null : _finishFreeRecall,
+                    child: const Text('Επόμενο'),
+                  ),
+                ],
+              ),
+            ],
+          ),
+        ),
+      );
+    }
+
+    if (_stage == 3) {
+      // No cues needed; complete immediately
+      Future.microtask(_complete);
+      return const SizedBox.shrink();
+    }
+
+    final word = _missing[_wordIndex];
+    final cue = _cues[word]!;
+    final options = List<String>.from(_choices[word]!);
+    options.shuffle(Random());
+
+    if (_stage == 1) {
+      return Scaffold(
+        appBar: AppBar(title: const Text('Υπόδειξη Κατηγορίας')),
+        body: Padding(
+          padding: const EdgeInsets.all(16),
+          child: Column(
+            crossAxisAlignment: CrossAxisAlignment.stretch,
+            children: [
+              Text('Δεν βρέθηκε: $word. Δοκιμάστε ξανά – $cue'),
+              const SizedBox(height: 12),
+              TextField(
+                controller: _controller,
+                decoration: const InputDecoration(
+                  border: OutlineInputBorder(),
+                  hintText: 'Απάντηση',
+                ),
+              ),
+              const SizedBox(height: 12),
+              Row(
+                mainAxisAlignment: MainAxisAlignment.center,
+                children: [
+                  IconButton(
+                    onPressed: _toggleListening,
+                    icon: Icon(_listening ? Icons.stop : Icons.mic),
+                  ),
+                  const SizedBox(width: 24),
+                  ElevatedButton(
+                    onPressed: _controller.text.isEmpty && !_listening ? null : _submitCue,
+                    child: const Text('Επόμενο'),
+                  ),
+                ],
+              ),
+            ],
+          ),
+        ),
+      );
+    }
+
+    return Scaffold(
+      appBar: AppBar(title: const Text('Επιλογή Λέξης')),
+      body: Padding(
+        padding: const EdgeInsets.all(16),
+        child: Column(
+          crossAxisAlignment: CrossAxisAlignment.stretch,
+          children: [
+            Text('Ποια λέξη ήταν στη λίστα;'),
+            const SizedBox(height: 20),
+            ...options.map((o) => Padding(
+                  padding: const EdgeInsets.symmetric(vertical: 4),
+                  child: ElevatedButton(
+                    onPressed: () => _submitChoice(o),
+                    child: Text(o),
+                  ),
+                )),
+          ],
+        ),
+      ),
+    );
+  }
+}
+
+class VerbalMemoryResult {
+  const VerbalMemoryResult({
+    required this.immediateTrials,
+    required this.delayedFreeRecall,
+    required this.categoryCueAnswers,
+    required this.choiceAnswers,
+    required this.score,
+  });
+
+  final List<String> immediateTrials;
+  final String delayedFreeRecall;
+  final Map<String, String?> categoryCueAnswers;
+  final Map<String, String?> choiceAnswers;
+  final int score;
+
+  Map<String, dynamic> toJson() => {
+        'immediateTrials': immediateTrials,
+        'delayedFreeRecall': delayedFreeRecall,
+        'categoryCueAnswers': categoryCueAnswers,
+        'choiceAnswers': choiceAnswers,
+        'score': score,
+      };
+}
