+import 'dart:async';
+import 'dart:math';
+import 'package:flutter/material.dart';
+import 'package:speech_to_text/speech_to_text.dart';
+
+/// Step - Sentence repetition using speech recognition.
+class RepeatSentencesStep extends StatefulWidget {
+  final VoidCallback onNext;
+  final void Function(int score) onScored;
+  const RepeatSentencesStep({
+    Key? key,
+    required this.onNext,
+    required this.onScored,
+  }) : super(key: key);
+
+  @override
+  State<RepeatSentencesStep> createState() => _RepeatSentencesStepState();
+}
+
+class _RepeatSentencesStepState extends State<RepeatSentencesStep> {
+  final SpeechToText _speech = SpeechToText();
+  final List<String> _phrases = const [
+    'Το μόνο που ξέρω είναι ότι ο Γιάννης είναι αυτός που θα βοηθήσει σήμερα',
+    'Η γάτα κρυβόταν πάντα κάτω από τον καναπέ όταν βρίσκονταν σκυλιά μέσα στο δωμάτιο',
+  ];
+
+  int _index = 0;
+  bool _showPhrase = true;
+  bool _listening = false;
+  String _recognized = '';
+  int _score = 0;
+  Timer? _timer;
+  bool _available = false;
+
+  @override
+  void initState() {
+    super.initState();
+    _initSpeech();
+    _timer = Timer(const Duration(seconds: 10), _startListening);
+  }
+
+  Future<void> _initSpeech() async {
+    _available = await _speech.initialize();
+    setState(() {});
+  }
+
+  Future<void> _startListening() async {
+    if (!_available) return;
+    setState(() {
+      _showPhrase = false;
+      _listening = true;
+      _recognized = '';
+    });
+    await _speech.listen(
+      localeId: 'el_GR',
+      onResult: (r) => setState(() => _recognized = r.recognizedWords),
+      listenFor: const Duration(seconds: 10),
+      pauseFor: const Duration(seconds: 3),
+    );
+  }
+
+  Future<void> _stopListening() async {
+    if (!_listening) return;
+    await _speech.stop();
+    setState(() => _listening = false);
+    _evaluate();
+  }
+
+  void _evaluate() {
+    final target = _phrases[_index]
+        .toLowerCase()
+        .replaceAll(RegExp('[.,«»]'), '')
+        .split(RegExp(r'\s+'));
+    final actual = _recognized
+        .toLowerCase()
+        .replaceAll(RegExp('[.,«»]'), '')
+        .split(RegExp(r'\s+'));
+    int diff = (target.length - actual.length).abs();
+    for (var i = 0; i < min(target.length, actual.length); i++) {
+      if (target[i] != actual[i]) diff++;
+    }
+    if (diff <= 1) _score++;
+  }
+
+  void _next() async {
+    await _stopListening();
+    _timer?.cancel();
+    if (_index < _phrases.length - 1) {
+      setState(() {
+        _index++;
+        _showPhrase = true;
+      });
+      _timer = Timer(const Duration(seconds: 10), _startListening);
+    } else {
+      widget.onScored(_score * 1); // each phrase 1 point => total 0-2
+      widget.onNext();
+    }
+  }
+
+  void _showHint() {
+    if (_showPhrase) return;
+    setState(() => _showPhrase = true);
+    _timer?.cancel();
+    _timer = Timer(const Duration(seconds: 3), () {
+      setState(() => _showPhrase = false);
+    });
+  }
+
+  @override
+  void dispose() {
+    _timer?.cancel();
+    _speech.stop();
+    super.dispose();
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    return Scaffold(
+      appBar: AppBar(title: const Text('Επανάληψη προτάσεων')),
+      body: Padding(
+        padding: const EdgeInsets.all(16),
+        child: Column(
+          mainAxisAlignment: MainAxisAlignment.center,
+          crossAxisAlignment: CrossAxisAlignment.stretch,
+          children: [
+            if (_showPhrase)
+              Text(
+                _phrases[_index],
+                textAlign: TextAlign.center,
+                style: const TextStyle(fontSize: 18),
+              )
+            else
+              Text(
+                _recognized,
+                textAlign: TextAlign.center,
+                style: const TextStyle(fontSize: 18),
+              ),
+            const SizedBox(height: 20),
+            ElevatedButton(
+              onPressed: _listening ? _stopListening : _startListening,
+              child: Icon(_listening ? Icons.stop : Icons.mic),
+            ),
+            const SizedBox(height: 10),
+            ElevatedButton(
+              onPressed: _showHint,
+              child: const Text('Υπόδειξη'),
+            ),
+            const SizedBox(height: 10),
+            ElevatedButton(
+              onPressed: _next,
+              child: const Text('Επόμενο'),
+            ),
+          ],
+        ),
+      ),
+    );
+  }
+}
 
