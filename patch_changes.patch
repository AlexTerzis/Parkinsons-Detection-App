+import 'dart:async';
+import 'package:flutter/material.dart';
+import 'package:flutter/services.dart';
+
+class NeuroStep13 extends StatefulWidget {
+  final VoidCallback onNext;
+  final void Function(int score) onScored;
+  const NeuroStep13({Key? key, required this.onNext, required this.onScored}) : super(key: key);
+
+  @override
+  State<NeuroStep13> createState() => _NeuroStep13State();
+}
+
+class _NeuroStep13State extends State<NeuroStep13> {
+  MethodChannel? _channel;
+  bool _completed = false;
+  Timer? _timeout;
+
+  @override
+  void initState() {
+    super.initState();
+    // Automatically finish after 20 seconds in case no gesture is detected
+    _timeout = Timer(const Duration(seconds: 20), _finish);
+  }
+
+  void _finish() {
+    if (_completed) return;
+    _completed = true;
+    widget.onScored(0);
+    widget.onNext();
+  }
+
+  @override
+  void dispose() {
+    _timeout?.cancel();
+    _channel?.setMethodCallHandler(null);
+    super.dispose();
+  }
+
+  void _onViewCreated(int id) {
+    _channel = MethodChannel('gesture_recognizer_channel_$id');
+    _channel!.setMethodCallHandler((call) async {
+      if (call.method == 'onGestures') {
+        final List<dynamic> gestures = call.arguments;
+        if (gestures.contains('Thumb_Up')) {
+          if (!_completed) {
+            _completed = true;
+            widget.onScored(1);
+            widget.onNext();
+          }
+        }
+      }
+    });
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    return Scaffold(
+      appBar: AppBar(title: const Text('Κίνηση αντίχειρα')),
+      body: Column(
+        children: [
+          const Padding(
+            padding: EdgeInsets.all(16),
+            child: Text('Κρατήστε το χέρι σας μπροστά στην κάμερα και δείξτε "thumbs up".'),
+          ),
+          Expanded(
+            child: AndroidView(
+              viewType: 'gesture_recognizer_view',
+              layoutDirection: TextDirection.ltr,
+              onPlatformViewCreated: _onViewCreated,
+            ),
+          ),
+        ],
+      ),
+    );
+  }
+}
 
