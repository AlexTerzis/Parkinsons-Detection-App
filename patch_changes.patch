+import 'dart:async';
+import 'package:flutter/material.dart';
+
+/// Step 5 of the Frontal Assessment Battery.
+/// The participant taps once when "1" appears and
+/// must withhold any tap when "2" appears. The
+/// same scoring rules as the conflicting step apply.
+class GoNoGoStep extends StatefulWidget {
+  final VoidCallback onNext;
+  final Function(int score) onScored;
+  const GoNoGoStep({
+    super.key,
+    required this.onNext,
+    required this.onScored,
+  });
+
+  @override
+  State<GoNoGoStep> createState() => _GoNoGoStepState();
+}
+
+class _GoNoGoStepState extends State<GoNoGoStep> {
+  static const List<int> _sequence = [1, 1, 2, 1, 2, 2, 2, 1, 1, 2];
+
+  int _index = -1; // index of current stimulus
+  int _current = 0; // number displayed to user
+  int _tapCount = 0; // taps recorded during current window
+  int _errors = 0; // total mistakes
+  int _sameStreak = 0; // consecutive trials copying the stimulus
+  bool _testDone = false;
+  int _phase = 0;
+  Timer? _timer;
+
+  @override
+  void dispose() {
+    _timer?.cancel();
+    super.dispose();
+  }
+
+  void _start() {
+    setState(() {
+      _phase = 1;
+      _index = -1;
+      _errors = 0;
+      _sameStreak = 0;
+      _tapCount = 0;
+      _testDone = false;
+    });
+    _next();
+  }
+
+  void _recordAnswer() {
+    if (_testDone) return;
+    setState(() => _tapCount++);
+  }
+
+  void _next() {
+    _timer?.cancel();
+
+    if (_index >= 0 && !_testDone) {
+      final stim = _sequence[_index];
+      final expected = stim == 1 ? 1 : 0; // tap for 1, inhibit for 2
+      if (_tapCount != expected) _errors++;
+      if (_tapCount == stim) {
+        _sameStreak++;
+      } else {
+        _sameStreak = 0;
+      }
+    }
+
+    setState(() {
+      _index += 1;
+      if (_index >= _sequence.length) {
+        _testDone = true;
+        _current = 0;
+      } else {
+        _current = _sequence[_index];
+        _tapCount = 0;
+      }
+    });
+
+    if (!_testDone) {
+      _timer = Timer(const Duration(milliseconds: 1500), _next);
+    }
+  }
+
+  void _finish() {
+    _timer?.cancel();
+    int score;
+    if (_sameStreak >= 4) {
+      score = 0;
+    } else if (_errors == 0) {
+      score = 3;
+    } else if (_errors <= 2) {
+      score = 2;
+    } else {
+      score = 1;
+    }
+    widget.onScored(score);
+    widget.onNext();
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    if (_phase == 0) {
+      return Scaffold(
+        appBar: AppBar(title: const Text('Go-No-Go')), 
+        body: Stack(
+          children: [
+            const Padding(
+              padding: EdgeInsets.all(24),
+              child: Text(
+                'Οδηγίες:\n'
+                'Πατήστε μία φορά όταν εμφανίζεται ο αριθμός 1.\n'
+                'Μην πατάτε όταν εμφανίζεται ο αριθμός 2.',
+                textAlign: TextAlign.center,
+                style: TextStyle(fontSize: 16),
+              ),
+            ),
+            Positioned(
+              right: 16,
+              bottom: 16,
+              child: ElevatedButton(
+                onPressed: _start,
+                child: const Text('Έναρξη'),
+              ),
+            ),
+          ],
+        ),
+      );
+    }
+
+    return Scaffold(
+      appBar: AppBar(title: const Text('Go-No-Go')),
+      body: Stack(
+        children: [
+          Center(
+            child: Column(
+              mainAxisAlignment: MainAxisAlignment.center,
+              children: [
+                Text(
+                  _testDone ? '-' : '$_current',
+                  style: const TextStyle(fontSize: 72, fontWeight: FontWeight.bold),
