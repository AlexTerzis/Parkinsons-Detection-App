+++ b/lib/ui/views/neuro_test/steps/conflicting_instructions.dart
@@ -0,0 +1,171 @@
+import 'dart:async';
+import 'package:flutter/material.dart';
+
+/// Step 4 of the Frontal Assessment Battery.
+/// The subject must perform the opposite number of taps
+/// to the one displayed on screen. Score is based on the
+/// number of errors and whether the subject mirrors the
+/// stimulus for four consecutive trials.
+class ConflictingInstructionsStep extends StatefulWidget {
+  final VoidCallback onNext;
+  final Function(int score) onScored;
+  const ConflictingInstructionsStep({
+    super.key,
+    required this.onNext,
+    required this.onScored,
+  });
+
+  @override
+  State<ConflictingInstructionsStep> createState() => _ConflictingInstructionsStepState();
+}
+
+class _ConflictingInstructionsStepState extends State<ConflictingInstructionsStep> {
+  // Predefined sequence of single or double taps from the examiner.
+  static const List<int> _sequence = [1, 1, 2, 1, 2, 2, 2, 1, 1, 2];
+
+  int _index = -1; // Current position within the sequence
+  int _current = 0; // Value currently shown to the user
+  int _tapCount = 0; // Number of taps recorded for the current stimulus
+  int _errors = 0; // Total mistakes
+  int _sameStreak = 0; // Times the subject copied the stimulus consecutively
+  bool _testDone = false;
+  int _phase = 0; // 0 = instructions, 1 = running test
+  Timer? _timer;
+
+  @override
+  void dispose() {
+    _timer?.cancel();
+    super.dispose();
+  }
+
+  void _start() {
+    setState(() {
+      _phase = 1;
+      _index = -1;
+      _errors = 0;
+      _sameStreak = 0;
+      _tapCount = 0;
+      _testDone = false;
+    });
+    _next();
+  }
+
+  void _recordAnswer() {
+    if (_testDone) return;
+    setState(() => _tapCount++);
+  }
+
+  void _next() {
+    _timer?.cancel();
+
+    // Evaluate the previous stimulus before moving on
+    if (_index >= 0 && !_testDone) {
+      final stim = _sequence[_index];
+      final expected = stim == 1 ? 2 : 1; // subject must do the opposite
+      if (_tapCount != expected) _errors++;
+      if (_tapCount == stim) {
+        // Subject mirrored the examiner
+        _sameStreak++;
+      } else {
+        _sameStreak = 0;
+      }
+    }
+
+    setState(() {
+      _index += 1;
+      if (_index >= _sequence.length) {
+        _testDone = true;
+        _current = 0;
+      } else {
+        _current = _sequence[_index];
+        _tapCount = 0;
+      }
+    });
+
+    if (!_testDone) {
+      // Allow 1.5s per item before auto-advancing
+      _timer = Timer(const Duration(milliseconds: 1500), _next);
+    }
+  }
+
+  void _finish() {
+    _timer?.cancel();
+    int score;
+    if (_sameStreak >= 4) {
+      score = 0;
+    } else if (_errors == 0) {
+      score = 3;
+    } else if (_errors <= 2) {
+      score = 2;
+    } else {
+      score = 1;
+    }
+    widget.onScored(score);
+    widget.onNext();
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    if (_phase == 0) {
+      return Scaffold(
+        appBar: AppBar(title: const Text('Εναντιούμενα παραγγέλματα')),
+        body: Stack(
+          children: [
+            const Padding(
+              padding: EdgeInsets.all(24),
+              child: Text(
+                'Οδηγίες:\n'
+                'Όταν εμφανίζεται ο αριθμός 1, πατήστε το κουμπί δύο φορές.\n'
+                'Όταν εμφανίζεται ο αριθμός 2, πατήστε το κουμπί μία φορά.',
+                textAlign: TextAlign.center,
+                style: TextStyle(fontSize: 16),
+              ),
+            ),
+            Positioned(
+              right: 16,
+              bottom: 16,
+              child: ElevatedButton(
+                onPressed: _start,
+                child: const Text('Έναρξη'),
+              ),
+            ),
+          ],
+        ),
+      );
+    }
+
+    return Scaffold(
+      appBar: AppBar(title: const Text('Εναντιούμενα παραγγέλματα')),
+      body: Stack(
+        children: [
+          Center(
+            child: Column(
+              mainAxisAlignment: MainAxisAlignment.center,
+              children: [
+                Text(
+                  _testDone ? '-' : '$_current',
+                  style: const TextStyle(fontSize: 72, fontWeight: FontWeight.bold),
+                ),
+                const SizedBox(height: 32),
+                ElevatedButton(
+                  onPressed: _testDone ? null : _recordAnswer,
+                  style: ElevatedButton.styleFrom(minimumSize: const Size(180, 48)),
+                  child: const Text('Πάτημα'),
+                ),
+              ],
+            ),
+          ),
+          if (_testDone)
+            Positioned(
+              right: 16,
+              bottom: 16,
+              child: ElevatedButton(
+                onPressed: _finish,
+                child: const Text('Επόμενο'),
+              ),
+            ),
+        ],
+      ),
+    );
+  }
+}
